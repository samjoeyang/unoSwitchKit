{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SwitchKit",
  "version": "0.4.2",
  "identifier": "com.switchkit.app",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU1QzVDRDcxMEIwNjcxNEIKUldSTGNRWUxjYzNGVlhwdFVxOWNpUXhQclJOS1hUSER0RTZUQkx2UHVNZW1rNmF0dm1WOVhJNUwK",
